# MongoDB Configuration File

# Network interfaces
net:
  port: {{ mongodb_net_port }}
  bindIp: {{ mongodb_net_bindip }}
  maxIncomingConnections: {{ mongodb_net_maxincomingconnections }}

# Process management
processManagement:
  fork: {{ mongodb_processmanagement_fork | lower }}
  pidFilePath: {{ mongodb_processmanagement_pidfilepath }}

# Storage options
storage:
  dbPath: {{ mongodb_storage_dbpath }}
  journal:
    enabled: {{ mongodb_storage_journal_enabled | lower }}
  engine: {{ mongodb_storage_engine }}
{% if mongodb_storage_directoryperdb %}
  directoryPerDB: {{ mongodb_storage_directoryperdb | lower }}
{% endif %}
  wiredTiger:
    engineConfig:
      cacheSizeGB: {{ mongodb_wiredtiger_cache_size_gb }}

# System log
systemLog:
  destination: {{ mongodb_systemlog_destination }}
  path: {{ mongodb_systemlog_path }}
  logAppend: {{ mongodb_systemlog_logappend | lower }}
  quiet: {{ mongodb_systemlog_quiet | lower }}

{% if mongodb_auth_enabled %}
# Security
security:
  authorization: enabled
  {% if mongodb_deployment_mode in ['replica_set', 'sharded_cluster'] %}
  keyFile: {{ mongodb_keyfile_path }}
  {% endif %}
{% endif %}

{% if mongodb_deployment_mode == 'replica_set' %}
# Replication
replication:
  replSetName: {{ mongodb_replication_replsetname }}
  oplogSizeMB: {{ mongodb_replication_oplogsizemb }}
{% endif %}

{% if mongodb_deployment_mode == 'sharded_cluster' %}
  {% if inventory_hostname in groups.get('mongodb_config_servers', []) %}
# Sharding - Config Server
sharding:
  clusterRole: configsvr
replication:
  replSetName: {{ mongodb_config_server_replsetname }}

# Override port for config servers
net:
  port: {{ mongodb_config_server_port }}
  bindIp: {{ mongodb_net_bindip }}
  maxIncomingConnections: {{ mongodb_net_maxincomingconnections }}
  {% elif inventory_hostname in groups.get('mongodb_shards', []) %}
# Sharding - Shard Server
sharding:
  clusterRole: shardsvr
replication:
  replSetName: >-
    {%- for group_name in group_names -%}
      {%- if group_name.startswith('shard') -%}
        {{ group_name }}ReplSet
      {%- endif -%}
    {%- endfor -%}

# Override port for shard servers
net:
  port: {{ mongodb_shard_port }}
  bindIp: {{ mongodb_net_bindip }}
  maxIncomingConnections: {{ mongodb_net_maxincomingconnections }}
  {% endif %}
{% endif %}
