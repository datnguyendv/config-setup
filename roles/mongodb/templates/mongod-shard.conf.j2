# MongoDB Shard Server Configuration
# Generated by Ansible for {{ inventory_hostname }}
# Shard: {{ current_shard_group }}

# Network interfaces
net:
  port: {{ mongodb_shard_port }}
  bindIp: {{ mongodb_net_bindip }}
  maxIncomingConnections: {{ mongodb_net_maxincomingconnections }}

# Process management
processManagement:
  fork: {{ mongodb_processmanagement_fork | lower }}
  pidFilePath: /var/run/mongodb/mongod-{{ current_shard_group }}.pid

# Storage options
storage:
  dbPath: {{ mongodb_storage_dbpath }}/{{ current_shard_group }}
  journal:
    enabled: {{ mongodb_storage_journal_enabled | lower }}
  engine: {{ mongodb_storage_engine }}
  wiredTiger:
    engineConfig:
      cacheSizeGB: {{ mongodb_wiredtiger_cache_size_gb }}

# System log
systemLog:
  destination: {{ mongodb_systemlog_destination }}
  path: /var/log/mongodb/mongod-{{ current_shard_group }}.log
  logAppend: {{ mongodb_systemlog_logappend | lower }}
  quiet: {{ mongodb_systemlog_quiet | lower }}

{% if mongodb_auth_enabled %}
# Security
security:
  authorization: enabled
  keyFile: {{ mongodb_keyfile_path }}
{% endif %}

# Sharding - Shard Server
sharding:
  clusterRole: shardsvr

# Replication
replication:
  replSetName: {{ current_shard_group }}ReplSet
