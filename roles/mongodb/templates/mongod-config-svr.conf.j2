# MongoDB Config Server Configuration
# Generated by Ansible for {{ inventory_hostname }}

# Network interfaces
net:
  port: {{ mongodb_config_server_port }}
  bindIp: {{ mongodb_net_bindip }}
  maxIncomingConnections: {{ mongodb_net_maxincomingconnections }}

# Process management
processManagement:
  fork: {{ mongodb_processmanagement_fork | lower }}
  pidFilePath: /var/run/mongodb/mongod-config.pid

# Storage options
storage:
  dbPath: {{ mongodb_storage_dbpath }}/config
  journal:
    enabled: {{ mongodb_storage_journal_enabled | lower }}
  engine: {{ mongodb_storage_engine }}
  wiredTiger:
    engineConfig:
      cacheSizeGB: {{ (mongodb_wiredtiger_cache_size_gb * 0.3) | round(1) }}

# System log
systemLog:
  destination: {{ mongodb_systemlog_destination }}
  path: /var/log/mongodb/mongod-config.log
  logAppend: {{ mongodb_systemlog_logappend | lower }}
  quiet: {{ mongodb_systemlog_quiet | lower }}

{% if mongodb_auth_enabled %}
# Security
security:
  authorization: enabled
  keyFile: {{ mongodb_keyfile_path }}
{% endif %}

# Sharding - Config Server
sharding:
  clusterRole: configsvr

# Replication
replication:
  replSetName: {{ mongodb_config_server_replsetname }}

