# Redis Sentinel configuration
# Generated by Ansible

port {{ redis_sentinel_port }}
dir {{ redis_dir }}

# Monitor master
sentinel monitor {{ redis_sentinel_master_name }} {{ groups['redis_master'] }} {{ redis_port }} {{ redis_sentinel_quorum }}

# Master authentication
{% if redis_password %}
sentinel auth-pass {{ redis_sentinel_master_name }} {{ redis_password }}
{% endif %}

# Failover configuration
sentinel down-after-milliseconds {{ redis_sentinel_master_name }} {{ redis_sentinel_down_after }}
sentinel failover-timeout {{ redis_sentinel_master_name }} {{ redis_sentinel_failover_timeout }}
sentinel parallel-syncs {{ redis_sentinel_master_name }} {{ redis_sentinel_parallel_syncs }}

# Logging
logfile {{ redis_log_dir }}/redis-sentinel.log
loglevel notice

# Security
{% if redis_password %}
requirepass {{ redis_password }}
{% endif %}
