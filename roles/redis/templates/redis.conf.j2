# Redis configuration for {{ item.name }}
# Generated by Ansible - DO NOT EDIT MANUALLY
# Instance: {{ item.description | default('Redis Instance') }}

################################## NETWORK #####################################
bind {{ redis_bind_interface }}
port {{ item.port }}
timeout {{ redis_timeout }}
tcp-keepalive {{ redis_tcp_keepalive }}
tcp-backlog {{ redis_tcp_backlog }}

################################# GENERAL #####################################
daemonize yes
supervised systemd
pidfile {{ redis_run_dir }}/{{ item.name }}.pid
loglevel {{ redis_loglevel }}
logfile {{ redis_log_dir }}/{{ item.name }}.log

# Set the number of databases
databases {{ item.databases | default(16) }}

################################ SNAPSHOTTING  ################################
dir {{ redis_base_dir }}/{{ item.name }}/data
dbfilename {{ item.name }}-dump.rdb

# Save configuration
{% for save_rule in item.save_config.split() %}
{% if loop.index0 % 2 == 0 %}
save {{ save_rule }}{% if not loop.last %} {{ item.save_config.split()[loop.index] }}{% endif %}
{% endif %}
{% endfor %}

stop-writes-on-bgsave-error {{ redis_stop_writes_on_bgsave_error | lower }}
rdbcompression {{ redis_rdbcompression | lower }}
rdbchecksum {{ redis_rdbchecksum | lower }}

################################# REPLICATION #################################
# (No replication settings for standalone mode)

################################## SECURITY ###################################
{% if redis_requireauth and redis_password %}
requirepass {{ redis_password }}
{% endif %}

################################### CLIENTS ####################################
maxclients {{ redis_maxclients }}

############################## MEMORY MANAGEMENT #############################
maxmemory {{ item.maxmemory }}
maxmemory-policy {{ item.maxmemory_policy | default('noeviction') }}

############################# LAZY FREEING ####################################
lazyfree-lazy-eviction no
lazyfree-lazy-expire no
lazyfree-lazy-server-del no
replica-lazy-flush no

############################ KERNEL OOM CONTROL ##############################
oom-score-adj no

############################# APPEND ONLY FILE #############################
{% if redis_appendonly %}
appendonly yes
appendfilename "{{ item.name }}.aof"
appendfsync {{ redis_appendfsync }}
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage {{ redis_auto_aof_rewrite_percentage }}
auto-aof-rewrite-min-size {{ redis_auto_aof_rewrite_min_size }}
{% else %}
appendonly no
{% endif %}

################################ LUA SCRIPTING  ###############################
lua-time-limit 5000

################################## SLOW LOG ###################################
slowlog-log-slower-than {{ redis_slowlog_log_slower_than }}
slowlog-max-len {{ redis_slowlog_max_len }}

################################ LATENCY MONITOR ##############################
latency-monitor-threshold 0

############################# EVENT NOTIFICATION ##############################
notify-keyspace-events ""

############################### ADVANCED CONFIG #############################
hash-max-ziplist-entries 512
hash-max-ziplist-value 64
list-max-ziplist-size -2
list-compress-depth 0
set-max-intset-entries 512
zset-max-ziplist-entries 128
zset-max-ziplist-value 64
hll-sparse-max-bytes 3000
stream-node-max-bytes 4096
stream-node-max-entries 100
activerehashing yes
client-output-buffer-limit normal 0 0 0
client-output-buffer-limit replica 256mb 64mb 60
client-output-buffer-limit pubsub 32mb 8mb 60
hz 10
dynamic-hz yes
aof-rewrite-incremental-fsync yes
rdb-save-incremental-fsync yes
