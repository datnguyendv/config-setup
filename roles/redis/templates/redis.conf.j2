# Redis configuration file
# Generated by Ansible

# Network
bind {{ redis_bind }}
port {{ redis_port }}
tcp-backlog {{ redis_tcp_backlog }}
timeout {{ redis_timeout }}
tcp-keepalive {{ redis_tcp_keepalive }}

# General
daemonize yes
supervised systemd
pidfile {{ redis_pid_file }}
loglevel notice
logfile {{ redis_log_dir }}/redis-server.log
databases {{ redis_databases }}

# Security
{% if redis_password %}
requirepass {{ redis_password }}
{% endif %}
protected-mode {{ redis_protected_mode | ternary('yes', 'no') }}

# Memory management
maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}

# Persistence
dir {{ redis_dir }}
{% for save_rule in redis_save %}
save {{ save_rule }}
{% endfor %}

# Replication (for replica nodes)
{% if redis_deployment_mode == 'replication' and inventory_hostname != groups['redis_master'] %}
replicaof {{ groups['redis_master'] }} {{ redis_port }}
{% if redis_password %}
masterauth {{ redis_password }}
{% endif %}
replica-read-only {{ redis_replica_read_only | ternary('yes', 'no') }}
replica-priority {{ redis_replica_priority }}
{% endif %}

# Append only file
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# Slow log
slowlog-log-slower-than 10000
slowlog-max-len 128
