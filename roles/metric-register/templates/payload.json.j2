{
    "ID": "{{ hostname }}:{{ consul_service_port }}",
    "Name": "{{ consul_service_name }}",
    "Address": "{{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }}",
    "Port": {{ consul_service_port }},
    "Meta": {
      "hostname": "{{ hostname }}",
      "prometheus": "true"
    },
    "check": {
      "http": "http://{{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }}:{{consul_service_port}}/metrics",
      "interval": "30s",
      "timeout": "5s"
    }
}
