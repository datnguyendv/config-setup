[Unit]
Description=Apache Kafka Server (KRaft mode)
Documentation=https://kafka.apache.org/documentation/
Requires=network.target
After=network.target

[Service]
Type=simple
User={{ kafka_user }}
Group={{ kafka_group }}
Environment="KAFKA_HEAP_OPTS=-Xmx{{ kafka_heap_size }} -Xms{{ kafka_heap_size }}"
Environment="KAFKA_OPTS={{ kafka_java_opts }}"
Environment="KAFKA_JMX_OPTS=-Dcom.sun.management.jmxremote=true -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Dcom.sun.management.jmxremote.port={{ kafka_jmx_port }}"

ExecStart={{ kafka_home }}/bin/kafka-server-start.sh {{ kafka_config_path }}/server.properties
ExecStop={{ kafka_home }}/bin/kafka-server-stop.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kafka

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
