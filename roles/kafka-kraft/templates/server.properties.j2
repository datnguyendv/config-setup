# KRaft mode configuration
process.roles={{ kafka_roles }}
node.id={{ kafka_node_id }}

# Controller configuration
controller.quorum.voters={{ controller_quorum_voters }}
controller.listener.names=CONTROLLER

# Listeners configuration  
{% if 'controller' in kafka_roles and 'broker' in kafka_roles %}
listeners=PLAINTEXT://0.0.0.0:{{ kafka_port }},CONTROLLER://0.0.0.0:{{ kafka_controller_port }}
advertised.listeners=PLAINTEXT://{{ hostname }}:{{ kafka_port }}
{% elif 'controller' in kafka_roles %}
listeners=CONTROLLER://0.0.0.0:{{ kafka_controller_port }}
{% else %}
listeners=PLAINTEXT://0.0.0.0:{{ kafka_port }}
advertised.listeners=PLAINTEXT://{{ hostname }}:{{ kafka_port }}
{% endif %}

listener.security.protocol.map=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
inter.broker.listener.name=PLAINTEXT

# Cluster and log configuration
log.dirs={{ kafka_data_dir }}
metadata.log.dir={{ kafka_meta_dir }}

# Network settings
num.network.threads={{ kafka_num_network_threads }}
num.io.threads={{ kafka_num_io_threads }}
socket.send.buffer.bytes={{ kafka_socket_send_buffer_bytes }}
socket.receive.buffer.bytes={{ kafka_socket_receive_buffer_bytes }}
socket.request.max.bytes={{ kafka_socket_request_max_bytes }}

# Topic settings
num.partitions={{ kafka_num_partitions }}
default.replication.factor={{ kafka_default_replication_factor }}
min.insync.replicas={{ kafka_min_insync_replicas }}
auto.create.topics.enable={{ kafka_auto_create_topics | lower }}

# Log retention
log.retention.hours={{ kafka_log_retention_hours }}
log.segment.bytes={{ kafka_log_segment_bytes }}
log.retention.check.interval.ms={{ kafka_log_retention_check_interval_ms }}

# JMX monitoring
jmx.port={{ kafka_jmx_port }}
